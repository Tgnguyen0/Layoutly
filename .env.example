DATABASE_URL=jdbc:postgresql://localhost:5432/layoutly
DATABASE_USER=layoutly
DATABASE_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=layoutly
POSTGRES_PORT=5432
LAYOUTLY_AUTH_SECURE_COOKIE=false
LAYOUTLY_PUBLIC_URL=http://localhost:5173
# Configure all mail settings before enabling password reset.
LAYOUTLY_PASSWORD_RESET_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Read-only, transactional import of existing file-based accounts:
LAYOUTLY_IMPORT_LEGACY=false
LAYOUTLY_LEGACY_OWNERSHIP_FILE=
